# ---------------------------------------------------------------
# V-Office server configuration. Copy to `server/.env` and adjust.
# ---------------------------------------------------------------

# development | production
NODE_ENV=development
PORT=5000

# MongoDB connection string (REQUIRED in production, e.g. MongoDB Atlas).
MONGO_URI=mongodb://127.0.0.1:27017/voffice

# Secret for signing login tokens (REQUIRED in production).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Allowed browser origin(s), comma-separated. Only needed if the client is hosted on a
# different domain than the API (the default single-service deployment doesn't need it).
CLIENT_URL=http://localhost:5173

# Serve the built React app from this server (defaults to true in production).
# SERVE_CLIENT=true

# Number of reverse proxies in front of the app (Render/Railway/Nginx = 1). Defaults to 1 in production.
# TRUST_PROXY=1

# Allow self-service sign-up at /register (new accounts are always regular employees).
# Anyone who can reach the site can then create an account and read the team chat,
# so set this to false for a private company deployment and create accounts as an admin.
ALLOW_REGISTRATION=false

# Presence & automatic check-out
# Close a session once its owner has had V-Office closed this long; the check-out time is
# recorded as when they left, so no phantom hours are logged. 0 = never.
AUTO_CHECKOUT_AFTER_MINUTES=15
# Hard cap for forgotten sessions. 0 = no cap.
MAX_SESSION_HOURS=12
# Grace period for page refreshes / brief network drops before someone shows as "Away".
PRESENCE_GRACE_SECONDS=20

# Optional tuning
# MONGO_POOL_SIZE=20
# AUTH_RATE_LIMIT=30      # login/register attempts per IP per 15 minutes
# API_RATE_LIMIT=600      # API requests per IP per minute
# AUTO_START_MONGO=false  # dev only: don't try to launch a local mongod on Windows
# SESSION_SWEEP_SECONDS=60  # how often automatic check-out rules run

# Resolve DNS through specific servers, only if your network cannot look up MongoDB Atlas
# SRV records (mongodb+srv://). Leave unset in Docker/Kubernetes.
# DNS_SERVERS=1.1.1.1,8.8.8.8
