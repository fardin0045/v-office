# ---------------------------------------------------------------
# V-Office client configuration (all optional). Copy to `client/.env.local`.
# Values are baked into the bundle at build time.
# ---------------------------------------------------------------

# Only set these if the API runs on a different domain than the website.
# By default the app calls same-origin /api and /socket.io.
# VITE_API_URL=https://api.example.com/api
# VITE_SOCKET_URL=https://api.example.com

# One-click demo account buttons on the sign-in page. Default: shown in development (`npm run dev`),
# hidden in production builds. They reveal working credentials of the seeded demo accounts.
# VITE_ENABLE_DEMO_LOGIN=true

# Dev server only: where Vite proxies /api and /socket.io (default http://localhost:5000).
# VITE_DEV_API_TARGET=http://localhost:5000
